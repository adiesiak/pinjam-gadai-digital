// =============================================================================
// STOP-UP! — Prisma Schema (referensi portabilitas)
//
// Runtime aplikasi ini berjalan di atas Convex (lihat src/convex/schema.ts dan
// src/convex/stopup/*) karena lingkungan Freebuff Web memakai Vite + React +
// Convex. File ini adalah padanan skema yang diminta spesifikasi agar sistem
// dapat dipindahkan ke deployment mandiri berbasis PostgreSQL + Prisma ORM
// tanpa mengubah model bisnis.
//
// Peta tipe uang:
//   SPEC "harga/nominal"  → DECIMAL(18,2)  (NUMERIC) — TIDAK memakai float/double.
//   Pada Convex, uang disimpan sebagai rupiah BULAT (integer) dan seluruh
//   pembagian dibulatkan eksplisit (src/lib/stopup/pricing.ts). Keduanya
//   konsisten: tidak ada floating-point error pada jalur transaksi.
//
// Jalankan:
//   npx prisma migrate dev --name stopup_init
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------- ENUM --------------------------------------

enum Role {
  ADMIN
  SUPERVISOR
  MEMBER
}

enum TerminalPaperStatus {
  OK
  LOW
  EMPTY
}

enum BrandKind {
  OPERATOR
  EWALLET
  PPOB
  PREMIUM
}

enum DeliveryType {
  INJECT_PHONE
  INJECT_EMAIL
  VOUCHER_CODE
  PPOB_INQUIRY
}

enum ProductStatus {
  AKTIF
  NONAKTIF
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  EXPIRED
}

enum PaymentMethod {
  QRIS
}

enum PaymentStatus {
  UNPAID
  PAID
  EXPIRED
}

enum SupplierMode {
  SANDBOX
  PRODUCTION
}

// ------------------------------- INTI --------------------------------------

model Terminal {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  location      String
  pinAdmin      String
  isOnline      Boolean  @default(false)
  lastHeartbeat DateTime @default(now())
  version       String?
  aktif         Boolean  @default(true)

  transactions  Transaction[]
  logs          TerminalLog[]
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String?
  role          Role     @default(MEMBER)
  whatsapp      String?
  balance       Decimal  @default(0) @db.Decimal(18, 2)
  createdAt     DateTime @default(now())

  transactions  Transaction[]

  @@index([role])
}

model Supplier {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  apiKey       String?
  secretKey    String?
  baseUrl      String?
  mode         SupplierMode @default(SANDBOX)
  // Saldo deposit di supplier H2H — dipantau Telegram Alert.
  balance      Decimal      @default(0) @db.Decimal(18, 2)
  isActive     Boolean      @default(true)
  priority     Int          @default(1)
  lastSyncAt   DateTime?
  lastSyncCount Int?

  products     Product[]

  @@index([isActive, priority])
}

model Category {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  icon      String?
  sortOrder Int       @default(0)
  aktif     Boolean   @default(true)

  products  Product[]
}

model Brand {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String
  kind       BrandKind
  icon       String?
  color      String?
  sortOrder  Int       @default(0)
  // Aturan panjang ID pelanggan untuk PPOB (PLN 11-12, Indihome 12, BPJS 13-16, PDAM 6-13).
  minDigit   Int?
  maxDigit   Int?
  contohId   String?
  labelTarget String?
  aktif      Boolean   @default(true)

  products   Product[]

  @@index([kind])
}

model Product {
  id                  String        @id @default(cuid())
  productCodeInternal String        @unique
  productCodeSupplier String
  name                String
  description         String?
  icon                String?
  iconUrl             String?
  badgeLabel          String?
  sortOrder           Int           @default(0)

  categoryId          String
  category            Category      @relation(fields: [categoryId], references: [id])
  brandId             String
  brand               Brand         @relation(fields: [brandId], references: [id])
  supplierId          String?
  supplier            Supplier?     @relation(fields: [supplierId], references: [id])

  hppPrice            Decimal       @db.Decimal(18, 2)
  sellPrice           Decimal       @db.Decimal(18, 2)
  discountPrice       Decimal?      @db.Decimal(18, 2)
  isDiscountActive    Boolean       @default(false)
  deliveryType        DeliveryType
  status              ProductStatus @default(AKTIF)
  diperbaruiPada      DateTime      @default(now())

  transactions        Transaction[]

  @@index([categoryId, brandId])
  @@index([status])
}

model Transaction {
  id                 String            @id @default(cuid())
  invoiceId          String            @unique
  terminalId         String
  terminal           Terminal          @relation(fields: [terminalId], references: [id])
  productId          String
  product            Product           @relation(fields: [productId], references: [id])
  userId             String?
  user               User?             @relation(fields: [userId], references: [id])

  targetNo           String
  accountNameMasked  String?
  notifWhatsapp      String
  buyerPhone         String?

  // Snapshot harga & laba saat transaksi (harga katalog bisa berubah nanti).
  sellPrice          Decimal           @db.Decimal(18, 2)
  hppPrice           Decimal           @db.Decimal(18, 2)
  profit             Decimal           @db.Decimal(18, 2)

  voucherCode        String?
  snRef              String?
  status             TransactionStatus @default(PENDING)
  catatanGagal       String?
  strukViaWhatsapp   Boolean           @default(false)

  createdAt          DateTime          @default(now())
  paidAt             DateTime?
  selesaiPada        DateTime?

  payment            Payment?

  @@index([status])
  @@index([createdAt])
  @@index([terminalId])
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String        @unique
  transactionId   String        @unique
  transaction     Transaction   @relation(fields: [transactionId], references: [id])
  paymentMethod   PaymentMethod @default(QRIS)
  qrString        String
  amount          Decimal       @db.Decimal(18, 2)
  status          PaymentStatus @default(UNPAID)
  gatewayRef      String?
  callbackPayload String?
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  paidAt          DateTime?

  @@index([status])
}

// Callback gateway bersifat APPEND-ONLY: dipakai untuk idempotensi & audit
// (satu eventId hanya boleh berefek finansial satu kali).
model WebhookEvent {
  id        String   @id @default(cuid())
  invoiceId String
  eventId   String   @unique
  applied   Boolean  @default(false)
  payload   String
  waktu     DateTime @default(now())

  @@index([invoiceId])
}

model TerminalLog {
  id               String              @id @default(cuid())
  terminalId       String
  terminal         Terminal            @relation(fields: [terminalId], references: [id])
  paperStatus      TerminalPaperStatus @default(OK)
  printerConnected Boolean             @default(false)
  supplierBalance  Decimal?            @db.Decimal(18, 2)
  catatan          String?
  loggedAt         DateTime            @default(now())

  @@index([terminalId, loggedAt])
}

model Setting {
  id                  String   @id @default(cuid())
  slot                String   @unique @default("global")
  idleResetDetik      Int      @default(45)
  idleWarningDetik    Int      @default(15)
  supplierTimeoutDetik Int     @default(25)
  simulasiPending     Boolean  @default(false)

  qrisProvider        String?
  qrisMerchantId      String?
  qrisMerchantName    String?
  qrisApiKey          String?
  qrisWebhookSecret   String?

  telegramBotToken    String?
  telegramChatId      String?
  telegramAlertAktif  Boolean  @default(false)
  lowBalanceThreshold Decimal  @default(500000) @db.Decimal(18, 2)

  printerAktif        Boolean  @default(true)
  namaMerchantStruk   String?
  alamatStruk         String?
  footerStruk         String?
  autoReloadJamWib    Int      @default(3)

  diperbaruiPada      DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  aktorLabel String
  aksi       String
  target     String?
  detail     String?
  waktu      DateTime @default(now())

  @@index([waktu])
}
