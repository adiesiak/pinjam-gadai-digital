# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# ---------------------------------------------------------------- klien (Vite)
# Alamat endpoint HTTP Convex (`.convex.site`) yang dipakai peramban untuk
# mengirim titik lokasi dan mengambil data publik.
VITE_CONVEX_SITE_URL=
# Kunci publik Turnstile; kunci rahasianya ada di bagian server di bawah.
VITE_TURNSTILE_SITE_KEY=
# Pelaporan galat runtime ke VLY (opsional). Tanpa keduanya, laporan tidak dikirim.
VITE_VLY_APP_ID=
VITE_VLY_MONITORING_URL=

# ------------------------------------------------------- server (Convex env)
# Disetel dengan `npx convex env set NAMA nilai`, bukan di berkas .env Vite.
#
# Origin aplikasi. Dipakai saat `SITE_URL` menunjuk domain backend Convex,
# supaya pengalihan Google mendarat di aplikasi, bukan di backend.
APP_ORIGIN=
# Alamat deployment Convex (`.convex.site`). Biasanya diisi platform sendiri;
# isi manual hanya bila deployment tidak menyediakannya.
SITE_URL=

# Rahasia penanda tangan tautan berkas (KTP, selfie, slip gaji). Tautan berkas
# MENOLAK dibuat tanpa rahasia asli. `JWT_PRIVATE_KEY` yang disetel Convex Auth
# dipakai sebagai cadangan, jadi deployment ber-Convex Auth biasanya sudah
# tercakup.
BERKAS_LINK_SECRET=
# Kunci privat JWT Convex Auth. Convex Auth menyetelnya sendiri saat
# `npx convex dev`; isi manual hanya bila deployment menyetelnya sendiri.
JWT_PRIVATE_KEY=

# Rahasia acak minimal 24 karakter untuk membuat admin pertama dari halaman
# admin. Jalur ini mati sendiri begitu ada satu admin.
ADMIN_BOOTSTRAP_SECRET=
# Kunci rahasia Turnstile (Cloudflare); diperiksa di server, bukan di peramban.
TURNSTILE_SECRET_KEY=

# Token gateway WhatsApp. `WHATSAPP_API_KEY` nama utamanya; `FONNTE_TOKEN`
# dibaca sebagai cadangan untuk deployment lama. Tanpa keduanya, OTP dan
# pengingat tidak terkirim.
WHATSAPP_API_KEY=
FONNTE_TOKEN=

# Masuk dengan Google (opsional). Tanpa keduanya, tombol Google nonaktif.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Integrasi VLY: pengiriman surel rincian dan somasi. `VLY_INTEGRATION_BASE_URL`
# boleh dikosongkan (bawaan https://integrations.vly.ai).
VLY_INTEGRATION_KEY=
VLY_INTEGRATION_BASE_URL=
VLY_CONVEX_AUTH_ISSUER=
