# Header keamanan untuk hosting statis yang membaca berkas `_headers`
# (Cloudflare Pages, Netlify). Host yang menjalankan `main.ts` memakai nilai yang
# sama dari berkas itu; kalau salah satu diubah, ubah keduanya.
#
# HSTS sengaja tanpa `preload`: preload sulit dicabut bila ada subdomain lama
# yang belum memakai HTTPS.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), magnetometer=(), gyroscope=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; manifest-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://*.convex.cloud wss://*.convex.cloud https://*.convex.site wss://*.convex.site https://challenges.cloudflare.com https://integrations.vly.ai; frame-src 'self' https://www.openstreetmap.org https://challenges.cloudflare.com; upgrade-insecure-requests

# Bundel ber-hash aman di-cache lama; HTML tetap divalidasi ulang.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
